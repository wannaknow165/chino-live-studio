[Unit]
Description=ARIEL phone link — public HTTPS address for /phone only (cloudflare quick tunnel)
After=network-online.target ariel-effects.service

[Service]
Type=simple
ExecStart=/bin/bash -c '/usr/local/bin/cloudflared tunnel --no-autoupdate --url http://127.0.0.1:7777 2>&1 | tee /opt/ariel-effects/tunnel.log'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
